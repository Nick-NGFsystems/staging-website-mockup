# ─────────────────────────────────────────────────────────────────────────────
# Perrine Interiors — environment variables
# Copy to .env.local for local dev. Set the same values in Vercel for production.
# ─────────────────────────────────────────────────────────────────────────────

# The site's public URL.
# MUST match client_configs.site_url in the NGF database EXACTLY — case, www and
# trailing slash are all normalized, but the host itself must be identical.
# If this doesn't match, getNgfContent() returns nothing and every page renders
# only its hardcoded fallbacks (the site looks fine but the client's edits from
# the portal never appear).
# NOT CONFIRMED YET. The business is "Perrine Interiors" (two r's), but
# perineinteriors.com has no DNS record and perrineinteriors.com answers a Wix
# "ConnectYourDomain Error" 404 — so neither spelling is serving this site.
# Ask Nick which domain Melissa actually owns before setting this in Vercel;
# setting the wrong one puts a dead host in every canonical tag and the sitemap.
# Left unset, the code falls back to the Vercel production URL, which resolves.
# NEXT_PUBLIC_SITE_URL=https://<confirmed-domain>

# NGF portal API base. Optional — defaults to https://app.ngfsystems.com.
NGF_APP_URL=https://app.ngfsystems.com

# Shared secret for POST /api/revalidate. Must match the value configured in the
# NGF app, otherwise the portal's publish webhook can't bust this site's cache.
WEBSITE_REVALIDATION_SECRET=

# Resend — contact form delivery.
RESEND_API_KEY=
# Must be a verified sender domain in Resend.
RESEND_FROM=noreply@ngfsystems.com

# ─── Analytics ───────────────────────────────────────────────────────────────
# GA4 measurement ID for THIS client's own property.
NEXT_PUBLIC_GA_ID=

# MUST be "1" whenever NEXT_PUBLIC_GA_ID is set. These two are a pair:
# GA4 is gated behind cookie consent, and the consent banner only renders when
# this is "1". Set the ID without this and the banner never appears, consent can
# never be granted, and analytics silently never load on a site that looks
# correctly configured. Set both, or neither.
NEXT_PUBLIC_COOKIE_ANALYTICS=
